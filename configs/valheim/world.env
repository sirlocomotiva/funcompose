# World "funcompose": the save name and the world modifiers.
#
# WORLD_NAME is the save in servers/valheim/config/worlds_local, as
# <WORLD_NAME>.fwl and <WORLD_NAME>.db. The seed is written into that save when
# the world is created; see configs/valheim/README.md for setting it.
WORLD_NAME=funcompose
#
# Modifiers, applied on every start. -preset sets them all, so it comes first;
# -modifier and -setkey after it change single settings.
SERVER_ARGS=-preset normal -modifier resources muchmore
