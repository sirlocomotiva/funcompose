# Valheim server settings shared by every world. The world name and its
# modifiers are in worlds/<name>.env. The password is in images/valheim/.env.
# Apply a change with:
#   docker compose -f images/valheim/docker-compose.yml up -d

SERVER_NAME=funcompose Valheim
# List the server in the community server browser.
SERVER_PUBLIC=true
# Let Xbox / Game Pass / Microsoft Store players join (uses UDP 2458).
CROSSPLAY=false
TZ=Etc/UTC

# SteamID64s, separated by spaces. Each replaces the matching list file on start.
# Leave empty to keep the lists the server maintains (in-game "ban", "permit", ...).
ADMINLIST_IDS=
BANNEDLIST_IDS=
# When set, only these players can join.
PERMITTEDLIST_IDS=

# Updates and restarts: only run while nobody is online.
UPDATE_CRON=*/15 * * * *
UPDATE_IF_IDLE=true
RESTART_CRON=10 5 * * *
RESTART_IF_IDLE=true

# World backups to servers/valheim/config/backups.
BACKUPS=true
BACKUPS_CRON=5 * * * *
BACKUPS_MAX_AGE=3
BACKUPS_IF_IDLE=false

# Mods: install BepInExPack Valheim and load every plugin in
# configs/valheim/bepinex/plugins. Players need the same mods.
BEPINEX=false
