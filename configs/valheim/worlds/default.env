# World "funcompose": vanilla rules.
#
# WORLD_NAME is the save in servers/valheim/config/worlds_local. A new name
# creates a new world, so every world file can have its own save.
WORLD_NAME=funcompose
#
# World modifiers, applied on every start (see configs/valheim/README.md):
#   -preset    normal | casual | easy | hard | hardcore | immersive | hammer
#   -modifier  combat       veryeasy | easy | hard | veryhard
#   -modifier  deathpenalty casual | veryeasy | easy | hard | hardcore
#   -modifier  resources    muchless | less | more | muchmore | most
#   -modifier  raids        none | muchless | less | more | muchmore
#   -modifier  portals      casual | hard | veryhard
#   -setkey    nobuildcost | playerevents | passivemobs | nomap
# Start with -preset, it resets every modifier. Modifiers after it override it.
# "-seed <seed>" picks the seed of a new world; it is ignored once the world exists.
SERVER_ARGS=-preset normal
