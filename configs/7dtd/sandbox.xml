	<property name="AmmoLootCount"					value="100%"/>	<!-- Ammo Abundance. Amount of ammo found in loot. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 300%, 400%, 500% -->
