	<property name="LootMaxTier"					value="default"/>	<!-- Max Loot Quality. Sets the highest quality of weapons and items that can appear in loot. Values are quality levels 1 to 6. Default: default. Values: default, 1, 2, 3, 4, 5, 6 -->
