	<property name="BloodMoonRange"					value="0"/>	<!-- Blood Moon Range. Number of days after Blood Moon frequency the event can occur. For example: A frequency of 7 + a range of 5 randomizes the Blood Moon between day 7 and day 12. 0 Days = No randomness. Default: 0. Values: 0, 1, 2, 3, 4, 7, 10, 14, 20 -->
	<property name="BloodMoonEnemyCount"			value="8"/>	<!-- Blood Moon Count. Controls the maximum number of zombies alive Per Player during a Blood Moon. Nearby players share a group cap of up to 30 zombies. If the cap would be exceeded, game stage scaling increases the difficulty instead. The world cap is about 1.9x the MaxSpawnedZombies. Lower game stages can reduce the number of spawns. Increasing this setting can greatly impact performance. Default: 8. Values: 4, 6, 8, 10, 12, 16, 24, 32, 64 -->
	<property name="BloodMoonWarning"				value="morning"/>	<!-- Blood Moon Warning. Sets when the Blood Moon warning appears on the HUD and the day number changes to red. Default: morning. Values: disabled, morning, evening -->
	<property name="AirDropFrequency"				value="3"/>	<!-- Air Drops. How often supply drops occur. Values are in-game days between drops; 1-3 means a random 1 to 3 days. Default: 3. Values: disabled, 1, 1-3, 3, 3-7, 7, 1-7 -->
	<property name="AirDropRandomTime"				value="none"/>	<!-- Air Drop Variance. Allows control over when the air drops appear. Pick a specific time for predictable air drops, or Any for total randomness. None = The default noon air drop. Morning = 04:00 - 10:00 Mid Day = 10:00 - 14:00 Evening = 15:00 - 20:00 Night = 20:00 - 24:00 All Day = 04:00 - 20:00. Default: none. Values: none, morning, mid day, evening, night, all day, any -->
	<property name="StormFreq"						value="100%"/>	<!-- Storm Frequency. Adjusts the frequency of storms. None disables storms. Default: 100%. Values: 0%, 50%, 100%, 150%, 200%, 300%, 400%, 500% -->
	<property name="StormWarning"					value="yes"/>	<!-- Storm Warning. Controls whether the player hears the storm siren and sees an on-screen storm warning. Default: yes. Values: no, yes -->
	<property name="HeatMapSensitivity"				value="default"/>	<!-- Heat Map Sensitivity. Controls heat buildup from player activity. Higher heat increases the chance for screamer spawns. Default uses XML config values. Default: default. Values: disabled, very low, low, default, high, very high -->
	<property name="DayNightLength"					value="60"/>	<!-- 24 Hour Cycle. How many real life minutes it takes for 24 hours to pass in the game. Default: 60. Values: 10, 20, 30, 40, 50, 60, 90, 120 -->
	<property name="DayLightLength"					value="18"/>	<!-- Daylight Length. Sets the number of in-game daylight hours. Always Night and Always Day behave as expected. Daylight duration settings: 4 = 10:00 - 14:00 6 = 09:00 - 15:00 8 = 08:00 - 16:00 10 = 07:00 - 17:00 12 = 06:00 - 18:00 14 = 05:00 - 19:00 16 = 04:00 - 20:00 18 = 04:00 - 22:00 20 = 02:00 - 22:00. Default: 18. Values: always night, 4, 6, 8, 10, 12, 14, 16, 18, 20, always day -->
	<property name="AirDropMarker"					value="yes"/>	<!-- Mark Air Drops. Display map and compass markers for supply drop locations. Default: yes. Values: no, yes -->
	<property name="AllowMap"						value="yes"/>	<!-- Allow Map. Enable in-game map. Default: yes. Values: no, yes -->
	<property name="AllowCompass"					value="yes"/>	<!-- Allow Compass. Show player compass. Default: yes. Values: no, yes -->
	<property name="AllowScreenMarkers"				value="yes"/>	<!-- Allow Screen Markers. Show on-screen navigational markers. Map markers remain visible. Default: yes. Values: no, yes -->
	<property name="ShowLocationInfo"				value="yes"/>	<!-- Show Location Info. Show biome and POI name and difficulty. Default: yes. Values: no, yes, name only -->
	<property name="ShowDayTime"					value="yes"/>	<!-- Show Day/Time. Show on-screen day and time information. If set to No, Bloodmoon Warning is also disabled. Default: yes. Values: no, yes -->

