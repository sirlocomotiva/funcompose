	<property name="EntityDamage"					value="100%"/>	<!-- Enemy Damage Dealt. Controls how much damage enemies do to players. This stacks with other incoming damage players receive. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="EntityIncomingDamage"			value="100%"/>	<!-- Entity Damage In. Damage entities, such as enemies and animals, receive from players. Default: 100%. Values: 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="BlockDamageAI"					value="100%"/>	<!-- Enemy Block Damage. How much damage enemies deal to blocks. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="BlockDamageAIBM"				value="100%"/>	<!-- BM Block Damage. Damage enemies do to blocks during Blood Moons. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
