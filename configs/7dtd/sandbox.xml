<?xml version="1.0"?>
<!--
	Sandbox options: the settings of the game's "Sandbox Options" screen (loot, XP,
	zombies, blood moons, day length, traders, quests, crafting, ...).

	The game reads them only as one SandboxCode setting. On every start the container
	turns this file into that code, so while this file exists the SandboxCode in
	serverconfig.xml is ignored. Restart the container to apply a change. It also
	applies to a save that already exists.

	The values start as the game's default for a new server (the Adventurer preset,
	code AAAJABJACJADJARFBNC). Each option lists its default and the values the game
	offers; use one of those. A percentage works with or without the "%".

	To load a code copied from the game, or to see the code this file makes, see
	"Sandbox options" in images/7dtd/README.md.
-->
<SandboxSettings>
	<!-- GENERAL -->
	<property name="RangedDamage"					value="150%"/>	<!-- Ranged Damage. Damage dealt by the player with bows, firearms, and other ranged weapons. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="MeleeDamage"					value="150%"/>	<!-- Melee Damage. Damage dealt by the player with melee weapons and tools. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="BlockDamage"					value="150%"/>	<!-- Block Damage. How much damage players deal to blocks. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="TerrainDamage"					value="150%"/>	<!-- Terrain Damage. How much damage players deal to terrain. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="HeadshotMultiplier"				value="100%"/>	<!-- Headshot Multiplier. Multiplier applied to headshot damage players deal to entities. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="IncomingDamage"					value="75%"/>	<!-- Player Damage In. How much damage the player receives from all sources. Default: 100%. Values: 0%, 25%, 35%, 50%, 65%, 75%, 85%, 100%, 125%, 150%, 200%, 250%, 300% -->
	<property name="WalkSpeed"						value="100%"/>	<!-- Walk Speed. Adjusts player movement speed while walking. Default: 100%. Values: 25%, 50%, 60%, 70%, 80%, 90%, 100%, 110%, 120%, 130%, 140%, 150%, 200%, 300% -->
	<property name="RunSpeed"						value="100%"/>	<!-- Run Speed. Adjusts player movement speed while running. Default: 100%. Values: 0%, 25%, 50%, 60%, 70%, 80%, 90%, 100%, 110%, 120%, 130%, 140%, 150%, 200%, 300% -->
	<property name="CrouchSpeed"					value="100%"/>	<!-- Crouch Speed. Adjusts player movement speed while crouching and walking. Default: 100%. Values: 0%, 25%, 50%, 60%, 70%, 80%, 90%, 100%, 110%, 120%, 130%, 140%, 150%, 200%, 300% -->
	<property name="CrouchRunSpeed"					value="100%"/>	<!-- Crouch Run Speed. Adjusts player movement speed while crouching and running. Default: 100%. Values: 0%, 25%, 50%, 60%, 70%, 80%, 90%, 100%, 110%, 120%, 130%, 140%, 150%, 200%, 300% -->
	<property name="JumpStrength"					value="100%"/>	<!-- Jump Strength. Modifies player jump height. Default: 100%. Values: 0%, 50%, 100%, 125%, 150%, 200%, 300% -->
	<property name="StaminaRegen"					value="100%"/>	<!-- Stamina Regen. Controls the rate stamina regenerates. Values are approximate. Default: 100%. Values: 25%, 50%, 75%, 100%, 125%, 150%, 200%, 300% -->
	<property name="StaminaUsage"					value="100%"/>	<!-- Stamina Usage. Stamina cost for actions like running, jumping, and attacking. Values are approximate. Default: 100%. Values: 0%, 25%, 50%, 75%, 100%, 125%, 150%, 175%, 200% -->
	<property name="XPMultiplier"					value="100%"/>	<!-- XP Multiplier. Multiplier applied to all experience gained. Default: 100%. Values: 0%, 25%, 50%, 75%, 100%, 125%, 150%, 175%, 200%, 300%, 500% -->
	<property name="ShowXP"							value="all"/>	<!-- Show XP. Hide or show the XP bar and XP pop-up on screen. Default: all. Values: all, bar only, notifications only, none -->
	<property name="PlayerLevelBonusApplied"		value="yes"/>	<!-- Level Stat Bonus. Determines whether health and stamina increase per level. Default: yes. Values: no, yes -->
	<property name="SkillGainRate"					value="1"/>	<!-- Skill Gain Rate. Adjusts how many levels are required to earn skill points. Values are player levels per skill point award. Default: 1. Values: 1, 2, 3, 4, 5 -->
	<property name="SkillPointsPerLevel"			value="1"/>	<!-- Skill Gain Amount. Controls how many skill points are gained when skill points are awarded. Default: 1. Values: 0, 1, 2, 3, 4, 5, 6, 7 -->
	<property name="NewbieCoat"						value="yes"/>	<!-- New Player Buff. If enabled, new players spawn with the beginner protection buff. Default: yes. Values: no, yes -->
	<property name="DeathPenalty"					value="xp only"/>	<!-- Death Penalty. Determines the death penalty applied after death. None = No penalty. XP Only = Classic XP loss. Injured = Some debuffs persist and food/water is reset to 50% on respawn. Permanent Death = Character reset. Default: xp only. Values: none, xp only, injured, permanent death -->
	<property name="LoseItemsOnDeathType"			value="none"/>	<!-- Lose On Death. Sets which items are considered for loss on death. None = Nothing All = All items. Toolbelt = Only toolbelt items. Backpack = Only backpack items. Equipment = Worn armor and clothing. Carried Only = Items from toolbelt and backpack. Default: none. Values: none, all, toolbelt only, backpack only, equipment, carried only -->
