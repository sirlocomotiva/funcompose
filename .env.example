# GameManager configuration
# Copy this file to .env and adjust:   cp .env.example .env

# ---- Ports (host side) ----
FRONTEND_PORT=5173
BACKEND_PORT=8000

# Range used for dynamically created game servers.
# Make sure the range covers every game you plan to run:
#   Minecraft 25565, Valheim 2456-2458, Terraria 7777, 7DtD 26900-26902
PORT_RANGE_START=7777
PORT_RANGE_END=27000

# ---- CurseForge ----
# Required to install CurseForge modpacks. Get a free API key at:
# https://console.curseforge.com/  (create an app, any name)
CF_API_KEY=

# ---- Notes ----
# - Works on Windows, macOS and Linux with Docker Desktop (or Docker Engine + compose plugin on Linux).
# - Game server data is stored in Docker-managed volumes (survives restarts & reboots).
